// Tier-1 angloform grammar. Terminals are form-tags (see lexicon.tsv);
// constructions are exactly those sanctioned by ADRs 0002–0014.
// LR(1)-clean by design: the PREP_N/PREP_V split (ADR 0011) removes PP
// attachment conflicts, coordination is factored so the token after CONJ
// decides predicate- vs clause-coordination (ADR 0004, binary only), and
// agreement/positivity variants are parameterized macros rather than
// hand-copied production sets.

use crate::{Tree, Tok, LexError, leaf, nd};

grammar;

extern {
    type Location = usize;
    type Error = LexError;

    enum Tok {
        "DET" => Tok::Det(<String>),
        "DET_SG" => Tok::DetSg(<String>),
        "ADJ" => Tok::Adj(<String>),
        "NOUN_SG" => Tok::NounSg(<String>),
        "NOUN_PL" => Tok::NounPl(<String>),
        "VT_BASE" => Tok::VtBase(<String>),
        "VT_3SG" => Tok::Vt3(<String>),
        "VT_ED" => Tok::VtEd(<String>),
        "VT_ING" => Tok::VtIng(<String>),
        "VI_BASE" => Tok::ViBase(<String>),
        "VI_3SG" => Tok::Vi3(<String>),
        "VI_ED" => Tok::ViEd(<String>),
        "VI_ING" => Tok::ViIng(<String>),
        "PREP_N" => Tok::PrepN(<String>),
        "PREP_V" => Tok::PrepV(<String>),
        "PRON_1" => Tok::Pron1(<String>),
        "PRON_2" => Tok::Pron2(<String>),
        "POSS" => Tok::Poss(<String>),
        "COP_SG" => Tok::CopSg(<String>),
        "COP_PL" => Tok::CopPl(<String>),
        "COP_SG_PAST" => Tok::CopSgPast(<String>),
        "COP_PL_PAST" => Tok::CopPlPast(<String>),
        "COP_1SG" => Tok::Cop1Sg(<String>),
        "CONJ" => Tok::Conj(<String>),
        "NEG" => Tok::Neg(<String>),
        "TEMP_ADV" => Tok::TempAdv(<String>),
        "TIME_ADV" => Tok::TimeAdv(<String>),
        "YET" => Tok::Yet(<String>),
        "FOCUS" => Tok::Focus(<String>),
        "OTHER" => Tok::Other(<String>),
        "DO_BASE" => Tok::DoBase(<String>),
        "DO_3SG" => Tok::Do3(<String>),
        "DO_PAST" => Tok::DoPast(<String>),
        "MODAL_MUST" => Tok::ModalMust(<String>),
        "MODAL_CAN" => Tok::ModalCan(<String>),
        "MODAL_CANNOT" => Tok::ModalCannot(<String>),
        "IF" => Tok::If(<String>),
        "THEN" => Tok::Then(<String>),
        "EVERY" => Tok::Every(<String>),
        "NO" => Tok::No(<String>),
        "NUM_SG" => Tok::Num(<String>),
        "NUM_PL" => Tok::NumPl(<String>),
        "PERCENT" => Tok::Percent(<String>),
        "APPROX" => Tok::Approx(<String>),
        "RESULT" => Tok::So(<String>),
        "REASON" => Tok::Because(<String>),
        "NAMELY" => Tok::Namely(<String>),
        "WHICH" => Tok::Which(<String>),
        "WHO" => Tok::Who(<String>),
        "ORD" => Tok::Ord(<String>),
        "THAN" => Tok::Than(<String>),
        "MORE" => Tok::More(<String>),
        "SCALE" => Tok::Scale(<String>),
        "ADJ_CMP" => Tok::AdjCmp(<String>),
        "ADJ_LONG" => Tok::AdjLong(<String>),
        "ADJ_SUP" => Tok::AdjSup(<String>),
        "MOST" => Tok::Most(<String>),
        "NUM_VAL" => Tok::NumVal(<String>),
        "BE" => Tok::Be(<String>),
        "BECOME_SG" => Tok::BecomeSg(<String>),
        "BECOME_PL" => Tok::BecomePl(<String>),
        "BECOME_PAST" => Tok::BecomePast(<String>),
        "SOME" => Tok::Some_(<String>),
        "NAME" => Tok::Name(<String>),
        "COMMA" => Tok::Comma,
        "COLON" => Tok::Colon,
    }
}

// ------------------------------------------------------ terminal wrappers

LDet: Tree = <l:@L> <w:"DET"> => leaf(l, w);
LDetSg: Tree = <l:@L> <w:"DET_SG"> => leaf(l, w);
LDetAny: Tree = { LDet, LDetSg };
// any adjective: short (inflecting) or long (ADR 0030)
LAdj: Tree = { <l:@L> <w:"ADJ"> => leaf(l, w), <l:@L> <w:"ADJ_LONG"> => leaf(l, w) };
LAdjLong: Tree = <l:@L> <w:"ADJ_LONG"> => leaf(l, w);
LBe: Tree = <l:@L> <w:"BE"> => leaf(l, w);
LBecomeSg: Tree = <l:@L> <w:"BECOME_SG"> => leaf(l, w);
LBecomePl: Tree = <l:@L> <w:"BECOME_PL"> => leaf(l, w);
LBecomePast: Tree = <l:@L> <w:"BECOME_PAST"> => leaf(l, w);
LNounSg: Tree = <l:@L> <w:"NOUN_SG"> => leaf(l, w);
LNounPl: Tree = <l:@L> <w:"NOUN_PL"> => leaf(l, w);
LVtBase: Tree = <l:@L> <w:"VT_BASE"> => leaf(l, w);
LVt3: Tree = <l:@L> <w:"VT_3SG"> => leaf(l, w);
LVtEd: Tree = <l:@L> <w:"VT_ED"> => leaf(l, w);
LViBase: Tree = <l:@L> <w:"VI_BASE"> => leaf(l, w);
LVi3: Tree = <l:@L> <w:"VI_3SG"> => leaf(l, w);
LViEd: Tree = <l:@L> <w:"VI_ED"> => leaf(l, w);
LPrepN: Tree = <l:@L> <w:"PREP_N"> => leaf(l, w);
LPrepV: Tree = <l:@L> <w:"PREP_V"> => leaf(l, w);
LPron1: Tree = <l:@L> <w:"PRON_1"> => leaf(l, w);
LPron2: Tree = <l:@L> <w:"PRON_2"> => leaf(l, w);
LPoss: Tree = <l:@L> <w:"POSS"> => leaf(l, w);
LCopSg: Tree = <l:@L> <w:"COP_SG"> => leaf(l, w);
LCopPl: Tree = <l:@L> <w:"COP_PL"> => leaf(l, w);
LCopSgPast: Tree = <l:@L> <w:"COP_SG_PAST"> => leaf(l, w);
LCopPlPast: Tree = <l:@L> <w:"COP_PL_PAST"> => leaf(l, w);
// "am" (ADR 0052): a distinct Form Tag from "is", valid only after "I" —
// Pred1Core is the only production that references it, so "the file am"
// can never parse (unlike reusing LCopSg, which would accept "am"
// anywhere a regular singular subject's copula is expected).
LCop1Sg: Tree = <l:@L> <w:"COP_1SG"> => leaf(l, w);
LConj: Tree = <l:@L> <w:"CONJ"> => leaf(l, w);
LNeg: Tree = <l:@L> <w:"NEG"> => leaf(l, w);
LTempAdv: Tree = <l:@L> <w:"TEMP_ADV"> => leaf(l, w);
LTimeAdv: Tree = <l:@L> <w:"TIME_ADV"> => leaf(l, w);
// "yet" (ADR 0046): a negative-polarity item, spliced only into
// productions where LNeg is mandatory in the same alternative, so it is
// never derivable without a negation already present.
LYet: Tree = <l:@L> <w:"YET"> => leaf(l, w);
// "only" (ADR 0047): confined inside an NP (never a free pre-predicate
// adverb), so its scope is exactly the NP it wraps — structural, not
// inferred from focus/stress the way plain written English needs.
LFocus: Tree = <l:@L> <w:"FOCUS"> => leaf(l, w);
// "other" (ADR 0049): confined to the second conjunct of a colon-list —
// never a free determiner, never the first conjunct. The Grammar accepts
// it here structurally; the Linter still verifies the domain-model
// relationship before calling the sentence Clean (mirrors ADR 0048's
// split — a CFG can't check that either).
LOther: Tree = <l:@L> <w:"OTHER"> => leaf(l, w);
// ADR 0049 (revised): bare "other" is banned outright — it's genuinely
// ambiguous between "all the rest" and "some unspecified rest" once the
// category has 3+ members (verified against the domain model: "sentence
// shape" has 4, "function word" has 6). "every other X" / "some other
// X" force the writer to say which, reusing the quantifiers ADR 0014
// already established rather than inventing new ones.
// agreement matches each quantifier's existing rule (ADR 0014): "every"
// takes a singular noun ("every other file"), "some" takes plural
// ("some other files") — not a free choice, "every other files" is not
// English.
OtherNp: Tree = {
    <q:LEvery> <o:LOther> <n:LNounSg> => nd("NPOther", 2, vec![Some(q), Some(o), Some(n)]),
    <q:LSome> <o:LOther> <n:LNounPl> => nd("NPOther", 2, vec![Some(q), Some(o), Some(n)]),
};
NPAnyOrOther: Tree = { NPAny, OtherNp };
LDoBase: Tree = <l:@L> <w:"DO_BASE"> => leaf(l, w);
LDo3: Tree = <l:@L> <w:"DO_3SG"> => leaf(l, w);
LDoPast: Tree = <l:@L> <w:"DO_PAST"> => leaf(l, w);
LModalMust: Tree = <l:@L> <w:"MODAL_MUST"> => leaf(l, w);
LModalCan: Tree = <l:@L> <w:"MODAL_CAN"> => leaf(l, w);
LModalCannot: Tree = <l:@L> <w:"MODAL_CANNOT"> => leaf(l, w);
LIf: Tree = <l:@L> <w:"IF"> => leaf(l, w);
LThen: Tree = <l:@L> <w:"THEN"> => leaf(l, w);
LComma: Tree = <l:@L> "COMMA" => leaf(l, ",".to_string());
LColon: Tree = <l:@L> "COLON" => leaf(l, ":".to_string());
LEvery: Tree = <l:@L> <w:"EVERY"> => leaf(l, w);
LNo: Tree = <l:@L> <w:"NO"> => leaf(l, w);
LNum: Tree = <l:@L> <w:"NUM_SG"> => leaf(l, w);
LNumPl: Tree = <l:@L> <w:"NUM_PL"> => leaf(l, w);
LPercent: Tree = <l:@L> <w:"PERCENT"> => leaf(l, w);
LApprox: Tree = <l:@L> <w:"APPROX"> => leaf(l, w);
LSo: Tree = <l:@L> <w:"RESULT"> => leaf(l, w);
LBecause: Tree = <l:@L> <w:"REASON"> => leaf(l, w);
// "namely" (ADR 0054 revision): mandatory marker between the
// Appositive's opening comma and its content — see the ApposSG
// definition below for why.
LNamely: Tree = <l:@L> <w:"NAMELY"> => leaf(l, w);
LWhich: Tree = <l:@L> <w:"WHICH"> => leaf(l, w);
LWho: Tree = <l:@L> <w:"WHO"> => leaf(l, w);
LOrd: Tree = <l:@L> <w:"ORD"> => leaf(l, w);
LThan: Tree = <l:@L> <w:"THAN"> => leaf(l, w);
LMore: Tree = <l:@L> <w:"MORE"> => leaf(l, w);
LScale: Tree = <l:@L> <w:"SCALE"> => leaf(l, w);
LAdjCmp: Tree = <l:@L> <w:"ADJ_CMP"> => leaf(l, w);
LAdjSup: Tree = <l:@L> <w:"ADJ_SUP"> => leaf(l, w);
LMost: Tree = <l:@L> <w:"MOST"> => leaf(l, w);
LNumVal: Tree = <l:@L> <w:"NUM_VAL"> => leaf(l, w);
LSome: Tree = <l:@L> <w:"SOME"> => leaf(l, w);
LName: Tree = <l:@L> <w:"NAME"> => leaf(l, w);

// ----------------------------------------------------------------- macros

// Verb predicate for one (transitive, intransitive) agreement pair. A
// colon right after the verb introduces an inline list of objects
// (EXPERIMENT: "the mechanism stores: a word and a message").
//
// Verb predicate for one (transitive, intransitive) agreement pair. A
// colon right after the verb introduces an inline list of objects
// (EXPERIMENT: "the mechanism stores: a word and a message").
VPn<Vt, Vi>: Tree = {
    <v:Vt> <o:NPAny> <p:PPv?> => nd("VP", 0, vec![Some(v), Some(o), p]),
    <v:Vt> <c:LColon> <n1:NPAny> <cj:LConj> <n2:NPAnyOrOther> => nd("VP", 0, vec![Some(v), Some(c), Some(n1), Some(cj), Some(n2)]),
    <v:Vi> <p:PPv?> => nd("VP", 0, vec![Some(v), p]),
};

// Do-support negation with the given auxiliary form.
NegVPn<D>: Tree = {
    <d:D> <n:LNeg> <v:VBaseP> => nd("NegVP", 2, vec![Some(d), Some(n), Some(v)]),
    <d:D> <n:LNeg> <y:LYet> <v:VBaseP> => nd("NegVP", 3, vec![Some(d), Some(n), Some(y), Some(v)]),
};

// Copular predicate (optionally negated) with the given copula form.
CopPredn<C>: Tree = {
    <c:C> <n:LNeg?> <cm:Compl> => nd("CopPred", 2, vec![Some(c), n, Some(cm)]),
    <c:C> <n:LNeg> <y:LYet> <cm:Compl> => nd("CopPred", 3, vec![Some(c), Some(n), Some(y), Some(cm)]),
};

// Positive-only copular predicate (for quantified subjects, ADR 0014).
CopPosn<C>: Tree = {
    <c:C> <cm:Compl> => nd("CopPred", 1, vec![Some(c), Some(cm)]),
};

// Determined NP with the given determiner class and noun number.
NPx<D, N>: Tree = {
    <d:D> <a:LAdj?> <n:N> <o:OfPP?> => nd("NP", 2, vec![Some(d), a, Some(n), o]),
};

// Inner NP (inside of-PPs): no further of-PP (no chains, ADR 0011).
NPi<D, N>: Tree = {
    <d:D> <a:LAdj?> <n:N> => nd("NP", 2, vec![Some(d), a, Some(n)]),
};

// Coordination tail for one predicate set (binary only, ADR 0004). A
// shared-subject predicate coordination only — comma-free (Pinker's rule:
// no new clause starts, so no comma). Full-clause coordination with a
// comma is `CoordClause` below, a sentence in its own right, not a suffix
// on Statement: Statement and Clause already share their "Subj Pred"
// reduction under LALR (Clause is embedded in Causal, itself starting the
// same way), so a comma-triggered continuation *inside* Statement's own
// production would collide with Causal's comma. Pulling it out to the
// Sentence level, parallel to Causal, resolves that: every context that
// wants a comma here now agrees on "reduce to Clause first," and only the
// token after the comma (so/because/CONJ) decides which sentence it is.
Tailn<P>: Tree = {
    <c:LConj> <p:P> => nd("CoordPred", 1, vec![Some(c), Some(p)]),
};

// ------------------------------------------------------------ enumeration

// Enumeration intro (ADR 0028): a plain statement ending in a colon; the
// items (parsed separately as Item) enumerate its final noun phrase.
pub Intro: Tree = {
    <s:Statement> <c:LColon> => nd("Intro", 0, vec![Some(s), Some(c)]),
};

// One step of a Step Block (ADR 0034): a clause with no coordination.
pub Step: Tree = { Clause };

// One item of an Enumeration: a noun phrase, or a bare singular term/name.
pub Item: Tree = {
    NPAny,
    <n:LNounSg> => n,
};

// -------------------------------------------------------------- sentences

pub Sentence: Tree = {
    Statement,
    Conditional,
    Causal,
    CoordClause,
    Prohibition,
    Imperative,
    RelSentence,
};

Statement: Tree = {
    <s:SubjSG> <p:PredSG> <t:Tailn<PredSG>?> => nd("S", 1, vec![Some(s), Some(p), t]),
    <s:ApposSG> <p:PredSG> <t:Tailn<PredSG>?> => nd("S", 1, vec![Some(s), Some(p), t]),
    <s:NPEvery> <p:PredEvery> => nd("S", 1, vec![Some(s), Some(p)]),
    <s:NPNo> <p:PredNo> => nd("S", 1, vec![Some(s), Some(p)]),
    <s:NPSome> <p:PredPL> => nd("S", 1, vec![Some(s), Some(p)]),
    <s:SubjPL> <p:PredPL> <t:Tailn<PredPL>?> => nd("S", 1, vec![Some(s), Some(p), t]),
    <s:Subj1> <p:Pred1> <t:Tailn<Pred1>?> => nd("S", 1, vec![Some(s), Some(p), t]),
};

// A shared-subject predicate Coordination stays comma-free inside a Clause
// too (ADR 0038), same as Statement's Tailn (ADR 0004/0021): "but"/"and"/
// "or" here only ever joins CONJ, never a comma, so this cannot collide
// with the comma-driven decisions Conditional/Causal/CoordClause make
// after a Clause reduces.
Clause: Tree = {
    <s:SubjSG> <p:PredSG> <t:CoordPredTail<PredSG>?> => nd("Clause", 1, vec![Some(s), Some(p), t]),
    <s:ApposSG> <p:PredSG> <t:CoordPredTail<PredSG>?> => nd("Clause", 1, vec![Some(s), Some(p), t]),
    <s:SubjPL> <p:PredPL> <t:CoordPredTail<PredPL>?> => nd("Clause", 1, vec![Some(s), Some(p), t]),
    <s:Subj1> <p:Pred1> <t:CoordPredTail<Pred1>?> => nd("Clause", 1, vec![Some(s), Some(p), t]),
};

CoordPredTail<P>: Tree = {
    <c:LConj> <p:P> => nd("CoordPred", 1, vec![Some(c), Some(p)]),
};

// if <clause> , then <clause> — mandatory comma and then (ADR 0007). Either
// clause may itself be a full-clause coordination (ADR 0038): the shared
// comma is always shifted first, and only the token after it (then/so/
// because vs. and/or/but) decides which continuation — the same
// reduce-then-branch shape ADR 0037 used to keep Causal and CoordClause
// conflict-free, applied one level deeper. Not factored through a shared
// "optionally-coordinated clause" nonterminal: that would recreate the
// exact ambiguity ADR 0037 fixed (a shift/reduce choice on the comma
// itself, before either continuation's marker is visible).
Conditional: Tree = {
    <i:LIf> <c:Clause> <cm:LComma> <t:LThen> <m:Clause> =>
        nd("Cond", 4, vec![Some(i), Some(c), Some(cm), Some(t), Some(m)]),
    <i:LIf> <c:Clause> <cm1:LComma> <cj:LConj> <c2:Clause> <cm2:LComma> <t:LThen> <m:Clause> =>
        nd("Cond", 4, vec![Some(i), Some(nd("CoordClause", 2, vec![Some(c), Some(cm1), Some(cj), Some(c2)])), Some(cm2), Some(t), Some(m)]),
    <i:LIf> <c:Clause> <cm:LComma> <t:LThen> <m:Clause> <cm2:LComma> <cj:LConj> <m2:Clause> =>
        nd("Cond", 4, vec![Some(i), Some(c), Some(cm), Some(t), Some(nd("CoordClause", 2, vec![Some(m), Some(cm2), Some(cj), Some(m2)]))]),
};

// <clause> , so <clause> — cause given, result new;
// <clause> , because <clause> — result given, reason new (ADR 0026).
// Comma mandatory. Either clause may itself be a full-clause coordination
// (ADR 0038) by the same reduce-then-branch shape as Conditional above.
Causal: Tree = {
    <c:Clause> <cm:LComma> <s:LSo> <r:Clause> =>
        nd("Causal", 2, vec![Some(c), Some(cm), Some(s), Some(r)]),
    <r:Clause> <cm:LComma> <b:LBecause> <c:Clause> =>
        nd("Causal", 2, vec![Some(r), Some(cm), Some(b), Some(c)]),
    <c:Clause> <cm1:LComma> <cj:LConj> <c2:Clause> <cm2:LComma> <s:LSo> <r:Clause> =>
        nd("Causal", 2, vec![Some(nd("CoordClause", 2, vec![Some(c), Some(cm1), Some(cj), Some(c2)])), Some(cm2), Some(s), Some(r)]),
    <r:Clause> <cm1:LComma> <cj:LConj> <r2:Clause> <cm2:LComma> <b:LBecause> <c:Clause> =>
        nd("Causal", 2, vec![Some(nd("CoordClause", 2, vec![Some(r), Some(cm1), Some(cj), Some(r2)])), Some(cm2), Some(b), Some(c)]),
    <c:Clause> <cm:LComma> <s:LSo> <r:Clause> <cm2:LComma> <cj:LConj> <r2:Clause> =>
        nd("Causal", 2, vec![Some(c), Some(cm), Some(s), Some(nd("CoordClause", 2, vec![Some(r), Some(cm2), Some(cj), Some(r2)]))]),
    <r:Clause> <cm:LComma> <b:LBecause> <c:Clause> <cm2:LComma> <cj:LConj> <c2:Clause> =>
        nd("Causal", 2, vec![Some(r), Some(cm), Some(b), Some(nd("CoordClause", 2, vec![Some(c), Some(cm2), Some(cj), Some(c2)]))]),
};

// <clause> , but/and/or <clause> — full-clause coordination, a new
// independent clause (ADR 0037; Pinker's rule via ADR 0021/0004). A
// sentence in its own right, parallel to Causal, not a suffix on Statement
// (see the note on Tailn above for why). The comma is mandatory; a
// shared-subject predicate coordination (no new clause) stays on
// Statement's comma-free Tailn instead.
//
// N-ary as of ADR 0050: a run of 3+ different-subject clauses (Oxford-comma
// style, conjunction only before the last) is a distinct empirical failure
// shape in docs/judge-report.md — a run of same-template different-subject
// sentences reads as tableized/mechanical prose far more often than any
// other single naturalness issue. `(<Clause> <LComma>)+` generalizes the
// old exact-binary production (one repetition == the old shape, so every
// previously-accepted 2-clause sentence still parses identically); no new
// LALR ambiguity, because a Clause never starts with Conj (and/or/but), so
// the parser always knows whether to keep collecting list items or to
// close the list at the final "Conj Clause". Only this standalone,
// Sentence-level form is generalized — Conditional's and Causal's own
// inline coordination (ADR 0038) stay binary; chaining 3+ clauses through
// "if"/"so"/"because" was judged out of scope for this pass (see
// docs/prompt-ab.md-adjacent decisions log).
CoordClause: Tree = {
    <c:Clause> <cm:LComma> <cj:LConj> <cl:Clause> =>
        nd("CoordClause", 2, vec![Some(c), Some(cm), Some(cj), Some(cl)]),
    <c:Clause> <cm1:LComma> <c2:Clause> <cm2:LComma> <cj:LConj> <cl:Clause> =>
        nd("CoordClause", 4, vec![Some(c), Some(cm1), Some(c2), Some(cm2), Some(cj), Some(cl)]),
};

// <clause> , which/who <predicate> — a non-restrictive relative clause
// (ADR 0059, revises ADR 0010), Sentence-level and sharing Causal/
// Conditional/CoordClause's exact "reduce Clause fully first, then
// branch on the token right after the comma" mechanism. An earlier
// attempt embedded this inside the object NP itself (low, inside VPn)
// and hit a real, confirmed LALR(1) conflict — see
// docs/relative-clause-design-2026-09-06.md for the full account,
// including why the grammar cannot verify the antecedent (subject vs.
// object) or the predicate's number agreement after this move — both
// routed to a not-yet-built Linter check (diagnose::relative_clause_checks).
RelSentence: Tree = {
    <c:Clause> <cm:LComma> <r:LWhich> <p:PredRel> <t:Tailn<PredRel>?> => nd("RelS", 2, vec![Some(c), Some(cm), Some(r), Some(p), t]),
    <c:Clause> <cm:LComma> <r:LWho> <p:PredRel> <t:Tailn<PredRel>?> => nd("RelS", 2, vec![Some(c), Some(cm), Some(r), Some(p), t]),
};

// -------------------------------------------------- definition grammar --
//
// Dedicated, tooling-only entry points (lexgen's future `definition`-field
// validator, per the lexicon-authoring-format design, 2026-09-07/08) — not
// reachable from `pub Sentence`, never used by ordinary prose. Same
// pattern already used for `pub Intro`/`pub Step`/`pub Item`: a separate
// `pub` start symbol, not a new architectural concept.
//
// NounDef: genus + MANDATORY differentia. Reuses RelSentence's own
// comma-then-which/who-then-PredRel tail, narrowed to require the
// preceding Clause be specifically a copula ("Subj is a Genus"), not any
// Clause — a bare "a group." with nothing after it is a grammar-level
// rejection, not a judgment call. SubjSG/LCopSg only for now (singular
// definitions) — every real trial definition was singular; SubjPL/LCopPl
// is a natural, low-risk future extension once evidenced.
pub NounDef: Tree = {
    <genus:NPSGCore> <cm:LComma> <r:LWhich> <p:PredRel> <t:Tailn<PredRel>?> =>
        nd("NounDef", 0, vec![Some(genus), Some(cm), Some(r), Some(p), t]),
    <genus:NPSGCore> <cm:LComma> <r:LWho> <p:PredRel> <t:Tailn<PredRel>?> =>
        nd("NounDef", 0, vec![Some(genus), Some(cm), Some(r), Some(p), t]),
};

// VerbTransDef: a bare verb phrase, no subject — re-exposes the exact
// nonterminal `Imperative` already uses (`VBaseP`, ADR 0019: "the verb
// is the signature"), zero new grammar. REVISED TWICE (2026-09-08):
// first required a mandatory Causal purpose/result tail — found
// gameable ("a tool builds a thing, so a new thing exists" satisfies it
// while staying just as vague) and too strict (rejected "a tool builds
// a file from parts," a genuinely better, concrete definition, purely
// for lacking a purpose clause it didn't need). Dropping the subject
// entirely is a stronger fix than either: real dictionary entries never
// restate a placeholder subject ("to build a file from parts," not "a
// tool builds a file from parts"), and removing the subject slot
// structurally disallows the vague-filler-subject pattern ("a tool
// does…", "a person does…") by construction — not a Linter judgment
// call catching it after the fact, the same "just don't allow the
// construction if there's a way to" principle already established in
// docs/garden-paths-2026-09-06.md. A vague *object* ("a thing") is
// still only lexically detectable, so that half stays a
// `diagnose::vague_appositive`-style Linter check, per ADR 0054's own
// precedent for exactly that kind of gap.
// Both defs carry an optional `Tailn<VBaseP>` tail (2026-09-08): the same
// binary same-subject "or"/"and"/"but" predicate coordination NounDef
// already uses (ADR 0004), reused as-is — not new grammar, just
// exercised here for the first time. Lets a definition approximate a
// missing abstract verb as a disjunction of concrete ones ("belong":
// "come from a community or stay in a place") instead of forcing one
// word to do work the lexicon has no word for.
pub VerbTransDef: Tree = {
    <b:VBaseP> <t:Tailn<VBaseP>?> => match t {
        None => b,
        Some(tail) => nd("DefOr", 0, vec![Some(b), Some(tail)]),
    },
};

// VerbIntransDef: identical grammar to VerbTransDef, not a mistake — the
// transitive/intransitive distinction doesn't need a second nonterminal
// here, because it's already enforced elsewhere: a word's Form Tag is
// fixed (one category per word), so VBaseP's transitive branch is simply
// unreachable for a word whose own head verb lexes as intransitive, and
// vice versa. A distinctly-named `pub` symbol purely for lexgen's
// dispatch-by-category clarity (VERB_INTRANS -> VerbIntransDefParser).
pub VerbIntransDef: Tree = {
    <b:VBaseP> <t:Tailn<VBaseP>?> => match t {
        None => b,
        Some(tail) => nd("DefOr", 0, vec![Some(b), Some(tail)]),
    },
};

// AdjDef: a bare, optionally-negated adjective phrase — no subject, no
// copula. REVISED (2026-09-08): originally wrapped in a full predicative
// clause ("a rare word is not common"), which forced picking an arbitrary
// (and often wrong-domain) subject noun ("word") just to have somewhere
// to attach the copula — the exact same over-narrowing problem the verb
// definitions had with "a tool"/"a file". Matches the same simplification
// already applied to NounDef (dropped the copula wrapper) and
// VerbTransDef (dropped the subject): real dictionary style is just the
// adjectival content itself ("not common"), nothing else. Covers plain
// ("small") and the negated-contrast shape the `antonym` field is meant
// to feed ("not common") — a comparative/PP-standard form ("bigger than
// X") is not yet supported; add it only once a real word needs it.
//
// TRIED AND REVERTED (2026-09-08): added an optional `PPv` tail
// (mirroring every verb definition) to try to fix "alone" ("not in a
// group" / "separate from a group") — neither phrasing actually worked
// once tried ("not in a group" has no adjective at all to attach the
// negation to; "separate"'s adjective sense is itself disabled in the
// lexicon, one-sense-per-word). No word ended up needing the tail, so
// it was reverted rather than kept as unused, speculative surface area
// — the same bar this comment already set ("only once a real word
// needs it") still hasn't been met.
pub AdjDef: Tree = {
    LAdj,
    <n:LNeg> <a:LAdj> => nd("AdjDef", 1, vec![Some(n), Some(a)]),
};

// do not <verb …> — prohibition (ADR 0005).
Prohibition: Tree = {
    <d:LDoBase> <n:LNeg> <v:VBaseP> => nd("Prohib", 2, vec![Some(d), Some(n), Some(v)]),
    <d:LDoBase> <n:LNeg> <y:LYet> <v:VBaseP> => nd("Prohib", 3, vec![Some(d), Some(n), Some(y), Some(v)]),
};

// <verb …> — bare imperative; the verb is the signature (ADR 0019).
Imperative: Tree = {
    <v:VBaseP> => nd("Imp", 0, vec![Some(v)]),
};

// --------------------------------------------------------------- subjects

SubjSG: Tree = { NPSG };
SubjPL: Tree = { NPPL, BarePl, LPron2 };
Subj1: Tree = { LPron1 };

// Appositive (ADR 0054, revised 2026-09-06): a comma-delimited noun
// phrase right after a singular subject, restating or defining it
// inline — lets a term's first use carry its own definition without a
// separate flat "X is a Y" sentence. Confined to SubjSG: a bare SubjSG
// is never otherwise followed by a comma (PredSG starts unconditionally
// after it in Statement/Clause), so this new "SubjSG COMMA" prefix
// cannot collide with any existing production — verified conflict-free
// by the LALRPOP build, not just reasoned by hand (ADR 0050's own
// lesson).
//
// "namely" is now MANDATORY right after the opening comma — not present
// in the original design. Reason: "Subj, NP," (no marker) is visually
// identical to an asyndetic list (2 comma-joined NPs, no "and") until
// the predicate's agreement resolves it, possibly many tokens later —
// a real, confirmed garden path (docs/garden-paths-2026-09-06.md), not
// a theoretical one: a direct human reaction to real example sentences
// flagged exactly this. "Subj, namely NP," cannot be misread as a list
// — no list ever opens its second item with "namely," and this is a
// word real English already uses for exactly this job (a non-
// restrictive restatement), not a punctuation workaround. The garden
// path is removed by construction, not detected after the fact.
//
// The inner phrase is NPAny — deliberately NOT restricted by structure
// (2 structural restrictions were tried and both falsified by direct
// A/B tests; see ADR 0054's Consequences for the full account). The
// real failure mode (a vague placeholder noun like "a term" used with
// no modifier) is a lexical/semantic one, not a structural one — "a
// Function Word" is just as bare, structurally, and tests fine. That
// distinction can't be a CFG rule (a grammar can't tell "term" from
// "Function Word" — both are just LNounSg), so it's a Tier-2 lint
// check instead (see diagnose::vague_appositive), the same split
// ADR 0048's same-verb-coordination check already uses for a
// distinction the grammar structurally cannot make.
ApposContent: Tree = { NPAny };
ApposSG: Tree = <s:SubjSG> <c1:LComma> <m:LNamely> <a:ApposContent> <c2:LComma> =>
    nd("Appos", 3, vec![Some(s), Some(c1), Some(m), Some(a), Some(c2)]);

// A trailing (right-branching) appositive was tried twice and dropped
// both times (2026-09-05) — not a design still in progress, a closed
// question. See ADR 0054's Consequences for the full account:
// attempt 1 (a bare COMMA trigger) hit a real, confirmed LALR(1)
// conflict — after "SubjSG LCopSg LAdj", the parser could not decide,
// on 1 token of lookahead, between reducing Compl=LAdj (the sentence
// is already complete on its own: "the Copula is safe" stands alone)
// and shifting into a trailing continuation, because COMMA is already
// claimed at that exact shared state by Causal/Conditional/CoordClause,
// and COLON is separately claimed there by Enumeration/Mapping's Intro.
// Attempt 2 (a dedicated "namely" token, avoiding the conflict — real
// English still wants a comma before "namely", which itself hits the
// same conflict, so it had to run comma-less: "the Copula is safe
// namely a Function Word") built and parsed cleanly, but scored WORSE
// on a real naturalness A/B (2/5) than the center-embedded original
// (4/5) — not primarily because of the missing comma (the judge called
// that "the smaller problem"), but because anchoring the trailing
// appositive to an unrelated NP-free adjective predicate ("is safe")
// forces the sentence to make a tangential claim before restating the
// subject from a distance, which reads as "two clauses stitched
// together." Center-embedding costs more structurally (Gibson's DLT)
// but keeps the appositive adjacent to the thing it restates, which
// mattered more here. Not reattempted with a 3rd anchor point without
// a genuinely different idea, not just a different token.

// ------------------------------------------------------------- predicates

// ADR 0044: an optional medial adverb ("still", "already") right before
// the predicate — the exact position real English uses for this class.
// Transparent when absent: the tree is byte-identical to the pre-0044
// shape, so nothing downstream needs to know about the wrapper unless a
// sentence actually uses one.
PredAdv<P>: Tree = {
    <a:LTempAdv?> <p:P> => match a {
        None => p,
        Some(av) => nd("PredAdv", 1, vec![Some(av), Some(p)]),
    },
};

PredSG: Tree = PredAdv<PredSGCore>;
PredSGCore: Tree = {
    VPn<LVt3, LVi3>,
    VPn<LVtEd, LViEd>,
    NegVPn<LDo3>,
    NegVPn<LDoPast>,
    ModalVP,
    CopPredn<LCopSg>,
    CopPredn<LCopSgPast>,
    // ADR 0035: become is a second copula with the same complements
    CopPredn<LBecomeSg>,
    CopPredn<LBecomePast>,
};

PredPL: Tree = PredAdv<PredPLCore>;
PredPLCore: Tree = {
    VPn<LVtBase, LViBase>,
    VPn<LVtEd, LViEd>,
    NegVPn<LDoBase>,
    NegVPn<LDoPast>,
    ModalVP,
    CopPredn<LCopPl>,
    CopPredn<LCopPlPast>,
    CopPredn<LBecomePl>,
    CopPredn<LBecomePast>,
};

// ADR 0059: the predicate inside a relative clause (RelSentence, below).
// The antecedent's number is locked inside an already-reduced, opaque
// Clause by the time the parser reaches this position, so the grammar
// cannot choose PredSG vs. PredPL here the way Statement/Clause do via
// the subject. Offering PredSG and PredPL as direct sibling
// alternatives was tried and is a genuine reduce/reduce conflict, not a
// theoretical one: several of their sub-productions are byte-identical
// regardless of number (past tense, modals, do-support past) and the
// build caught it. This is their deduplicated union instead — every
// verb-form alternative once, agreement recoverable from the actual
// word chosen (PredSGCore's LVt3 vs PredPLCore's LVtBase are always
// different tokens for a given lexicon entry, so no ambiguity remains
// inside this union itself). The Linter checks the chosen form actually
// agrees with the real antecedent's number
// (diagnose::relative_clause_checks — not yet built), the same
// Grammar-accepts/Linter-verifies split already used for who/which.
PredRel: Tree = PredAdv<PredRelCore>;
PredRelCore: Tree = {
    VPn<LVt3, LVi3>,
    VPn<LVtBase, LViBase>,
    VPn<LVtEd, LViEd>,
    NegVPn<LDo3>,
    NegVPn<LDoBase>,
    NegVPn<LDoPast>,
    ModalVP,
    CopPredn<LCopSg>,
    CopPredn<LCopPl>,
    CopPredn<LCopSgPast>,
    CopPredn<LCopPlPast>,
    CopPredn<LBecomeSg>,
    CopPredn<LBecomePl>,
    CopPredn<LBecomePast>,
};

// First person: base agreement for ordinary verbs. The Copula (ADR 0052)
// gets a real "am" (LCop1Sg, present) — reusing "is" would parse but read
// as "I is", not the collapse-irregular-forms move it looks like (unlike
// was/were -> "was", which is already correct English for "I"). The past
// tense already works for free: LCopSgPast is "was", and "I was" is
// standard English, so no new word was needed there.
Pred1: Tree = PredAdv<Pred1Core>;
Pred1Core: Tree = {
    VPn<LVtBase, LViBase>,
    VPn<LVtEd, LViEd>,
    NegVPn<LDoBase>,
    NegVPn<LDoPast>,
    ModalVP,
    CopPredn<LCop1Sg>,
    CopPredn<LCopSgPast>,
    // ADR 0035's become agrees with "I" like any base-form verb: "become",
    // not "becomes" (LBecomeSg is 3rd-singular, wrong for "I" — the same
    // base/3sg distinction Pred1Core already makes for ordinary verbs above).
    CopPredn<LBecomePl>,
    CopPredn<LBecomePast>,
};

// Positive-only predicate sets for quantified subjects (ADR 0014);
// no + must is additionally banned.
PredEvery: Tree = PredAdv<PredEveryCore>;
PredEveryCore: Tree = {
    VPn<LVt3, LVi3>,
    <m:LModalMust> <v:VBaseP> => nd("ModalVP", 1, vec![Some(m), Some(v)]),
    <m:LModalCan> <v:VBaseP> => nd("ModalVP", 1, vec![Some(m), Some(v)]),
    <m:LModalMust> <b:LBe> <cm:Compl> => nd("ModalCop", 1, vec![Some(m), Some(b), Some(cm)]),
    <m:LModalCan> <b:LBe> <cm:Compl> => nd("ModalCop", 1, vec![Some(m), Some(b), Some(cm)]),
    CopPosn<LCopSg>,
    CopPosn<LCopSgPast>,
    CopPosn<LBecomeSg>,
    CopPosn<LBecomePast>,
};
PredNo: Tree = PredAdv<PredNoCore>;
PredNoCore: Tree = {
    VPn<LVt3, LVi3>,
    <m:LModalCan> <v:VBaseP> => nd("ModalVP", 1, vec![Some(m), Some(v)]),
    <m:LModalCan> <b:LBe> <cm:Compl> => nd("ModalCop", 1, vec![Some(m), Some(b), Some(cm)]),
    CopPosn<LCopSg>,
    CopPosn<LCopSgPast>,
    CopPosn<LBecomeSg>,
    CopPosn<LBecomePast>,
};

ModalVP: Tree = {
    <m:LModalMust> <n:LNeg?> <v:VBaseP> => nd("ModalVP", 2, vec![Some(m), n, Some(v)]),
    <m:LModalMust> <n:LNeg> <y:LYet> <v:VBaseP> => nd("ModalVP", 3, vec![Some(m), Some(n), Some(y), Some(v)]),
    <m:LModalCan> <v:VBaseP> => nd("ModalVP", 1, vec![Some(m), Some(v)]),
    <m:LModalCannot> <v:VBaseP> => nd("ModalVP", 1, vec![Some(m), Some(v)]),
    // ADR 0032: "be" exists only after a modal, with the copula's complements
    <m:LModalMust> <n:LNeg?> <b:LBe> <cm:Compl> => nd("ModalCop", 2, vec![Some(m), n, Some(b), Some(cm)]),
    <m:LModalMust> <n:LNeg> <y:LYet> <b:LBe> <cm:Compl> => nd("ModalCop", 3, vec![Some(m), Some(n), Some(y), Some(b), Some(cm)]),
    <m:LModalCan> <b:LBe> <cm:Compl> => nd("ModalCop", 1, vec![Some(m), Some(b), Some(cm)]),
    <m:LModalCannot> <b:LBe> <cm:Compl> => nd("ModalCop", 1, vec![Some(m), Some(b), Some(cm)]),
};

VBaseP: Tree = {
    <v:LVtBase> <o:NPAny> <p:PPv?> => nd("VP", 0, vec![Some(v), Some(o), p]),
    <v:LVtBase> <c:LColon> <n1:NPAny> <cj:LConj> <n2:NPAnyOrOther> => nd("VP", 0, vec![Some(v), Some(c), Some(n1), Some(cj), Some(n2)]),
    <v:LViBase> <p:PPv?> => nd("VP", 0, vec![Some(v), p]),
};

// ------------------------------------------------------------ noun phrases

// ADR 0047: an optional leading "only" — transparent when absent (same
// tree as before 0047), wrapping in "NPOnly" only when used. Confined to
// the NP itself, so "only" can never scope over the verb or the clause.
NPSG: Tree = {
    <o:LFocus?> <n:NPSGCore> => match o {
        None => n,
        Some(ow) => nd("NPOnly", 1, vec![Some(ow), Some(n)]),
    },
};
NPSGCore: Tree = {
    NPx<LDet, LNounSg>, NPx<LDetSg, LNounSg>, NPx<LPoss, LNounSg>, NPx<LNum, LNounSg>,
    // ordinal (ADR 0029): "the first word", "the 4th file", "a first draft"
    <d:LDetAny> <o:LOrd> <a:LAdj?> <n:LNounSg> <of:OfPP?> =>
        nd("NP", 3, vec![Some(d), Some(o), a, Some(n), of]),
    // superlative (ADR 0056): a short adjective inflects ("the biggest
    // file"), a long one takes "most" (ADR 0030's inflected/periphrastic
    // split, reused). The optional of-PP names the set, same slot as the
    // Ordinal's, unforced the same way (ADR 0029 didn't force it either).
    <d:LDetAny> <s:LAdjSup> <a:LAdj?> <n:LNounSg> <of:OfPP?> =>
        nd("NP", 3, vec![Some(d), Some(s), a, Some(n), of]),
    <d:LDetAny> <m:LMost> <a:LAdjLong> <n:LNounSg> <of:OfPP?> =>
        nd("NP", 3, vec![Some(d), Some(m), Some(a), Some(n), of]),
    // proper names (ADR 0018): bare, or appositive after a noun
    <nm:LName> => nm,
    <d:LDet> <a:LAdj?> <n:LNounSg> <nm:LName> <o:OfPP?> =>
        nd("NPAppos", 2, vec![Some(d), a, Some(n), Some(nm), o]),
    NPPctSg,
};
// digits count plural nouns (ADR 0022); *one* + singular is NPSG (ADR 0016)
NPPL: Tree = {
    <o:LFocus?> <n:NPPLCore> => match o {
        None => n,
        Some(ow) => nd("NPOnly", 1, vec![Some(ow), Some(n)]),
    },
};
NPPLCore: Tree = { NPx<LDet, LNounPl>, NPx<LPoss, LNounPl>, NPNum, NPPct };

// [about] <digits> [adj] <plural noun> [of-PP] — a count, optionally
// approximate (ADR 0022, 0025).
// "the 2 words": a definite count is allowed (the set is already known)
// a scale word may follow the digits: "20 million files" (ADR 0029)
NPNum: Tree = {
    <d:LDet?> <ap:LApprox?> <n:LNumPl> <sc:LScale?> <a:LAdj?> <nn:LNounPl> <o:OfPP?> =>
        nd("NP", 5, vec![d, ap, Some(n), sc, a, Some(nn), o]),
};

// <digits> percent of <plural NP> — a share of a named set; plural
// agreement (ADR 0024). The of-PP is mandatory: the set must be named.
// Restricted to a plural inner NP (not the generic OfPP/NPInner) so this
// never overlaps the singular-mass sibling below — the 2 rules partition
// on the noun's own number, no LALR ambiguity.
NPPct: Tree = {
    <ap:LApprox?> <n:LNumPl> <p:LPercent> <prep:LPrepN> <np:NPi<LDet, LNounPl>> =>
        nd("NPPct", 2, vec![ap, Some(n), Some(p), Some(nd("OfPP", 1, vec![Some(prep), Some(np)]))]),
};

// <digits> percent of <singular mass NP> — a share of an uncounted whole;
// singular agreement (ADR 0057, ADR 0024's deferral): "50 percent of the
// file is the text", unlike a percent of a counted set above.
NPPctSg: Tree = {
    <ap:LApprox?> <n:LNumPl> <p:LPercent> <prep:LPrepN> <np:NPi<LDet, LNounSg>> =>
        nd("NPPct", 2, vec![ap, Some(n), Some(p), Some(nd("OfPP", 1, vec![Some(prep), Some(np)]))]),
};

// every + singular; no + singular is subject-only (ADR 0014).
NPEvery: Tree = { NPx<LEvery, LNounSg> };
NPNo: Tree = { NPx<LNo, LNounSg> };
NPSome: Tree = { NPx<LSome, LNounPl> };

NPAny: Tree = { NPSG, NPPL, BarePl, NPEvery };

// Bare plural: generic/characterizing reading only, by fiat (ADR 0013).
BarePl: Tree = {
    <a:LAdj?> <n:LNounPl> <o:OfPP?> => nd("NPGen", 1, vec![a, Some(n), o]),
};

// of-PP attaches to the preceding noun (ADR 0011).
OfPP: Tree = {
    <p:LPrepN> <np:NPInner> => nd("OfPP", 1, vec![Some(p), Some(np)]),
};

NPInner: Tree = {
    // a defined or quoted name inside an of-PP: "every sentence of Angloform"
    <nm:LName> => nm,
    // a bare plural inside an of-PP (2026-09-08, lexicon-authoring-format
    // trial): "a group of people", "a box of items" — the same bare-plural
    // NP already used at the top level (NPAny's BarePl) was previously
    // unreachable here, forcing an ungrammatical "of the people" or
    // dropping the of-PP genus pattern entirely just to name a generic
    // plural constituent.
    BarePl,
    // appositive name inside an of-PP: "every form of the file "lexicon.tsv""
    <d:LDet> <a:LAdj?> <n:LNounSg> <nm:LName> =>
        nd("NPAppos", 2, vec![Some(d), a, Some(n), Some(nm)]),
    NPi<LNum, LNounSg>,
    <d:LDetAny> <o:LOrd> <a:LAdj?> <n:LNounSg> =>
        nd("NP", 3, vec![Some(d), Some(o), a, Some(n)]),
    <d:LDetAny> <s:LAdjSup> <a:LAdj?> <n:LNounSg> =>
        nd("NP", 3, vec![Some(d), Some(s), a, Some(n)]),
    <d:LDetAny> <m:LMost> <a:LAdjLong> <n:LNounSg> =>
        nd("NP", 3, vec![Some(d), Some(m), Some(a), Some(n)]),
    <d:LDet?> <ap:LApprox?> <n:LNumPl> <sc:LScale?> <a:LAdj?> <nn:LNounPl> =>
        nd("NP", 5, vec![d, ap, Some(n), sc, a, Some(nn)]),
    NPi<LDet, LNounSg>,
    NPi<LDet, LNounPl>,
    NPi<LDetSg, LNounSg>,
    NPi<LPoss, LNounSg>,
    NPi<LPoss, LNounPl>,
};

// Verb-attaching PP; at most one per clause (ADR 0011).
PPv: Tree = {
    <p:LPrepV> <np:NPAny> => nd("PP", 1, vec![Some(p), Some(np)]),
    // ADR 0045: "afterward" — the bare, no-anchor twin of "after <NP>";
    // same slot, no object (an Idiomatic Structure of PPv itself).
    <l:LTimeAdv> => nd("PP", 0, vec![Some(l)]),
};

// Copular complement: adjective or noun phrase (ADR 0003); or a comparative
// with its standard (ADR 0030): "heavier than the length", "more transparent
// than the compound". The standard is mandatory.
Compl: Tree = {
    LAdj,
    NPAny,
    // ADR 0057: a bare share as a value, not a noun phrase referring to a
    // set — "the load is 43 percent" states a measurement, so the of-PP
    // naming a set (mandatory on NPPct/NPPctSg above, ADR 0024) does not
    // apply here; confined to the Complement slot, so it can never stand
    // as a subject or object the way a real (anaphoric) bare share would.
    <ap:LApprox?> <n:LNumPl> <p:LPercent> =>
        nd("NPPct", 2, vec![ap, Some(n), Some(p), None]),
    // ADR 0058: a bare digit as a measurement value — "the value is 3",
    // "the value is 0", optionally approximate (ADR 0025) — a value slot
    // distinct from the NUM_PL count slot (ADR 0022): "0" tokenizes as
    // NUM_VAL, never NUM_PL, so it still cannot reach a count position
    // ("0 files" stays unparseable) even though it is legal here.
    LNumPl,
    LNumVal,
    <ap:LApprox> <n:LNumPl> => nd("Value", 1, vec![Some(ap), Some(n)]),
    <ap:LApprox> <n:LNumVal> => nd("Value", 1, vec![Some(ap), Some(n)]),
    // ADR 0031: one verb-preposition phrase may follow a noun-phrase
    // complement and attaches to it — the copula has no object to compete
    <np:NPAny> <pp:PPv> => nd("ComplPP", 0, vec![Some(np), Some(pp)]),
    // ADR 0055: same attachment, an adjective complement instead of a noun
    // phrase — "the copies are identical to the report" (ADR 0023's
    // deferred named-standard form).
    <a:LAdj> <pp:PPv> => nd("ComplPP", 0, vec![Some(a), Some(pp)]),
    <c:LAdjCmp> <t:LThan> <np:NPAny> => nd("Cmp", 0, vec![Some(c), Some(t), Some(np)]),
    <m:LMore> <a:LAdjLong> <t:LThan> <np:NPAny> => nd("Cmp", 1, vec![Some(m), Some(a), Some(t), Some(np)]),
};
